    "permissions": ["activeTab"],
    "browser_action": {
        "default_icon": "icons/icon.svg"
    },
    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": [
                "https://duckduckgo.com/email/",
                "https://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion/email/"
            ],
            "js": ["content.js"],
            "css": ["styles.css"],
            "run_at": "document_start"
        }
    ]
}