    "content_scripts": [
        {
            "matches": [
                "https://duckduckgo.com/email/",
                "https://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion/email/"
            ],
            "css": ["styles.css"]
        }
    ]
}